# ─────────────────────────────────────────────────────────────────────────────
# Verify — backend environment
#
# Copy to `.env` and fill in. NEVER commit `.env` (NFR-SEC-01, T-03).
# `src/config/env.js` validates every var below at boot and refuses to start
# if a required one is missing or malformed — so an incomplete deploy fails
# loudly at startup rather than silently at the first request.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development
PORT=3001
# Public origin of the Nuxt app. Used for the CORS allowlist, claim links and
# QR payloads. Comma-separate to allow more than one origin.
FRONTEND_URL=http://localhost:3000

# ── Supabase ──
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# service_role key. Bypasses RLS — server-side only, never sent to the browser.
SUPABASE_SERVICE_KEY=
# anon/public key. Used for the RLS-bound client (non-privileged reads).
SUPABASE_ANON_KEY=
# Legacy HS256 projects only: Project Settings → API → JWT Secret.
# Leave EMPTY if the project uses asymmetric JWT signing keys — the backend
# then verifies tokens against the project's JWKS endpoint instead.
SUPABASE_JWT_SECRET=

# ── Blockchain ──
# Alchemy HTTPS RPC endpoint (Amoy testnet for dev, Polygon mainnet for prod).
ALCHEMY_RPC_URL=
# Platform relayer wallet holding ISSUER_ROLE. 0x + 64 hex chars.
# SECRET. Railway env vars only. Loss requires redeployment + role re-grant.
PRIVATE_KEY=
# Deployed CertificateRegistry address for the network above.
CONTRACT_ADDRESS=
# 80002 = Polygon Amoy testnet · 137 = Polygon mainnet.
# Checked against the RPC's reported chain ID at boot so a testnet key can
# never accidentally sign a mainnet transaction.
CHAIN_ID=80002

# ── Email (Resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=Verify <noreply@verify.app>

# ── Monitoring (optional in dev) ──
SENTRY_DSN=
LOG_LEVEL=debug
