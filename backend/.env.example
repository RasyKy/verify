# ─────────────────────────────────────────────────────────────────────────────
# Verify — backend environment
#
# Copy to `.env` and fill in. NEVER commit `.env` (NFR-SEC-01, T-03).
# `src/config/env.js` validates every var below at boot and refuses to start
# if a required one is missing or malformed — so an incomplete deploy fails
# loudly at startup rather than silently at the first request.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=development
PORT=3001
# Public origin of the Nuxt app. Used for the CORS allowlist, claim links and
# QR payloads. Comma-separate to allow more than one origin.
FRONTEND_URL=http://localhost:3000

# ── Supabase ──
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# service_role key. Bypasses RLS — server-side only, never sent to the browser.
SUPABASE_SERVICE_KEY=
# anon/public key. Used for the RLS-bound client (non-privileged reads).
SUPABASE_ANON_KEY=
# Legacy HS256 projects only: Project Settings → API → JWT Secret.
# Leave EMPTY if the project uses asymmetric JWT signing keys — the backend
# then verifies tokens against the project's JWKS endpoint instead.
SUPABASE_JWT_SECRET=

# ── Blockchain ──
# Alchemy HTTPS RPC endpoint (Amoy testnet for dev, Polygon mainnet for prod).
ALCHEMY_RPC_URL=
# Platform relayer wallet holding ISSUER_ROLE. 0x + 64 hex chars.
# SECRET. Railway env vars only. Loss requires redeployment + role re-grant.
PRIVATE_KEY=
# Deployed CertificateRegistry address for the network above.
CONTRACT_ADDRESS=
# 80002 = Polygon Amoy testnet · 137 = Polygon mainnet.
# Checked against the RPC's reported chain ID at boot so a testnet key can
# never accidentally sign a mainnet transaction.
CHAIN_ID=80002

# ── Email ──
# Two transports. SMTP wins when SMTP_USER and SMTP_PASSWORD are both set;
# otherwise Resend is used if RESEND_API_KEY is set; otherwise email is
# disabled and claim links are logged instead of sent.

# — Option A: SMTP via a Gmail app password (no domain needed) —
# Sends as the authenticated Gmail account, so SPF/DKIM align and any recipient
# receives the mail. Limit is roughly 500 recipients/day.
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an app password:     https://myaccount.google.com/apppasswords
#   3. Paste it below — the display spaces are stripped automatically.
SMTP_USER=
SMTP_PASSWORD=
# Display name only. The address is always SMTP_USER: Gmail rewrites any other
# From to the authenticated account unless it is a verified "send mail as".
MAIL_FROM_NAME=Verify
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# — Option B: Resend (needs a verified sending domain) —
RESEND_API_KEY=
# Must be a domain verified in your Resend dashboard, or the shared sender
# below. The in-code fallback (noreply@verify.app) is a domain nobody owns, so
# Resend rejects it for real recipients — claim emails fail while the service
# reports itself as enabled. The shared sender onboarding@resend.dev needs no
# DNS but delivers ONLY to the Resend account owner's own address.
RESEND_FROM_EMAIL=Verify <onboarding@resend.dev>

# ── Monitoring (optional in dev) ──
SENTRY_DSN=
LOG_LEVEL=debug
