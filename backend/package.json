{
  "name": "verify-backend",
  "version": "1.0.0",
  "description": "Verify \u2014 REST API for certificate issuance, claiming and blockchain-backed verification",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env --import ./src/instrument.js src/server.js",
    "start": "node --import ./src/instrument.js src/server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "db:check": "node --env-file=.env scripts/check-supabase.js",
    "db:migrate": "node --env-file=.env scripts/apply-migrations.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "auth:templates": "node --env-file=.env scripts/set-auth-email-templates.js",
    "auth:templates:preview": "node scripts/set-auth-email-templates.js --preview",
    "auth:otp": "node --env-file=.env scripts/print-otp.js",
    "chain:sync": "node --env-file=.env scripts/sync-chain-ledger.js",
    "db:seed:clean": "node --env-file=.env scripts/seed.js --clean",
    "db:seed:chain": "node --env-file=.env scripts/seed.js --chain",
    "smoke:chain": "node --env-file=.env scripts/smoke-chain.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "keywords": [
    "certificates",
    "blockchain",
    "polygon",
    "express"
  ],
  "author": "Chhay Lyhour",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.19.0",
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/supabase-js": "^2.108.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jose": "^6.2.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "puppeteer-core": "^25.9.0",
    "qrcode": "^1.5.4",
    "resend": "^6.16.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.1",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
