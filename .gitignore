# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
!.env.example

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
contracts/node_modules/

# Build outputs
frontend/.nuxt/
frontend/.output/
dist/

# Hardhat
contracts/artifacts/
contracts/cache/

# Misc
.DS_Store
*.log

# Regenerated by `npm run db:seed` on every run, and carries a live claim token
# plus the dev password. Run the seed to get your own.
backend/db/postman_environment.json

# Rendered by `npm run auth:templates:preview` so an email design change can be
# eyeballed without pushing it to a live Supabase project. Regenerated on demand.
backend/.auth-email-preview.html

# Local ledger for the in-memory blockchain stub (services/blockchain.js), used
# until Verifier.sol is deployed. Machine-local dev state, like a database file.
backend/.stub-chain.json

# Scratch notes only — project docs under docs/ MUST stay tracked.
# (Was `*.md`, which silently ignored docs/api-schema.md, ER diagrams, etc.)
/notes/

# Local Claude Code project instructions — not shared with the team
/CLAUDE.md